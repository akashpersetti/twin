# Frontend environment variables

# Non-streaming API URL (fallback, for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Streaming API URL for real token streaming (populated by deploy.sh in production)
NEXT_PUBLIC_STREAM_API_URL=http://localhost:8000/chat/stream

# Avatar cache buster (auto-set by deploy.sh in production)
# NEXT_PUBLIC_AVATAR_VERSION=<unix-timestamp>
